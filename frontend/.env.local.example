NEXT_PUBLIC_API_URL=https://your-backend.railway.app/api

# Platform root domain. kadehub.com = hub, pos./cod./tasks./staff. = products, any other subdomain = a shop (POS).
# Local dev: kadehub.localhost:3000 (open http://kadehub.localhost:3000, http://pos.kadehub.localhost:3000 …).
# Leave unset locally to skip host routing entirely (plain http://localhost:3000 behaves like before).
NEXT_PUBLIC_ROOT_DOMAIN=kadehub.com
# Optional override for the shared login cookie's Domain (default: .<root domain>, host-only on *.localhost)
# NEXT_PUBLIC_COOKIE_DOMAIN=.kadehub.com

# Gmail credentials for quote form emails (use an App Password, not your account password)
GMAIL_USER=official.kadehub@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
