DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

PORT=3001
NODE_ENV=production
FRONTEND_URL=https://your-app.vercel.app
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Gmail for billing notifications
GMAIL_USER=your_gmail_address
GMAIL_APP_PASSWORD=your_gmail_app_password

# MinIO Object Storage
MINIO_ENDPOINT=your_minio_endpoint
MINIO_BUCKET=your_bucket_name
MINIO_ACCESS_KEY=your_minio_access_key
MINIO_SECRET_KEY=your_minio_secret_key

# OnePay Payment Gateway (https://onepay.lk)
# Get these from your OnePay merchant dashboard
ONEPAY_APP_ID=your_onepay_app_id
ONEPAY_APP_TOKEN=your_onepay_app_token
ONEPAY_HASH_SALT=your_onepay_hash_salt

# Bank transfer (used while OnePay is not configured)
# Super admin can also edit these from Super Admin → Settings
BANK_NAME=SAMPATH BANK PLC
BANK_ACCOUNT_NAME=M D S D SILVA
BANK_ACCOUNT_NUMBER=1031 5529 6530
BANK_BRANCH=MORATUWA BRANCH
BANK_INSTRUCTIONS=Transfer the exact amount, then upload a photo or PDF of your bank slip. Use your shop name as the payment reference.

# Cloudflare DNS — for automatic subdomain creation on registration
# Get API token from https://dash.cloudflare.com/profile/api-tokens
# Zone ID from your domain's Overview page in Cloudflare dashboard
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_ZONE_ID=your_cloudflare_zone_id
CLOUDFLARE_BASE_DOMAIN=kadehub.com
